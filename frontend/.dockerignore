# Keep the frontend build context small and secret-free (mirrors backend/.dockerignore).

# Dependencies + build output — reinstalled via `npm ci` / regenerated by `vite build`
node_modules/
dist/
dist-ssr/

# Secrets — VITE_* are injected at build time via --build-arg, never copied from a file.
# Excluding .env* keeps frontend/.env.local out of the image layers (T-157-SEC).
.env
.env.*

# Version control + editor cruft
.git
.gitignore
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Tests + coverage — not bundled by the SPA build
coverage/
playwright-report/
test-results/
e2e/

# Build-context meta (mirrors backend/.dockerignore)
.dockerignore
