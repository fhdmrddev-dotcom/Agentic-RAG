# frontend/Dockerfile.dockerignore — Phase 276 (D-23).
#
# The onebox frontend image now builds from the REPO ROOT (docker-compose.prod.yml:
# `context: .` + `dockerfile: frontend/Dockerfile`), so this file — BuildKit's per-Dockerfile
# ignore, read because it sits next to the Dockerfile with the same name + `.dockerignore`
# (assumption A3) — is what keeps the build context small and secret-free. frontend/.dockerignore
# is inert under the root context. Paths here are relative to the REPO ROOT.

# Dependencies + build output — reinstalled by `npm install` / regenerated by `vite build`
**/node_modules
frontend/dist
frontend/dist-ssr

# Secrets — VITE_* are build args, never copied from a file (T-157-SEC, T-276-08)
**/.env
**/.env.*

# Everything the frontend image never reads (T-276-08)
.git
backend/
supabase/
.planning/
.claude/
.agent-bus/
graphify-out/
scratch/
screenshots/
deploy/

# Video: only video/src and the wav VO / mp3 music under video/public are wanted
video/out/
video/public/notebooklm/
video/public/music/*.wav
video/tools/

# Logs, tests, coverage
**/*.log
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/e2e/
