# Keep peer dependencies from auto-installing. npm 7+ defaults to installing a
# package's optional peerDependencies, which would re-pull `antd` + `@lobehub/ui`
# (~344 packages) as `@lobehub/icons` peers and break the Phase 128 / T-128-01
# antd-free guarantee. We import ONLY `@lobehub/icons` `.Color`/`.Mono` marks
# (pure SVG, zero runtime deps), never `.Avatar` — so these peers are never needed.
legacy-peer-deps=true
