# frontend/Dockerfile — 2-stage build for the all-in-one docker-compose.prod.yml (Phase 157, D-03).
#   stage 1 (node)  : install deps + produce the static Vite `dist`
#   stage 2 (nginx) : serve `dist` + reverse-proxy /api/ -> backend:8000 (see nginx.conf)
# Base image tags pinned per 157-RESEARCH: node:22-alpine (build) + nginx:1.27-alpine (runtime).

# ---- build stage ----
FROM node:22-alpine AS build
WORKDIR /app

# node:22-alpine ships npm 10.9.8, but package-lock.json is generated by npm 11.x on dev
# machines. npm 10 and npm 11 resolve/dedupe the tree differently, so npm 10's `npm ci`
# rejects the (valid) npm-11 lockfile as "Missing:/Invalid: ... from lock file". Pin npm to
# the lockfile-generating major so `npm ci` reads it identically — the reproducible-build
# fix (surfaced by the Phase-158 wizard smoke; the Phase-157 frontend build was never smoked).
RUN npm install -g npm@11.4.0

# VITE_* are BUILD-TIME values — Vite inlines import.meta.env.VITE_* into the JS bundle when
# the build runs, so they must be ARG -> ENV BEFORE the build (NOT runtime env; a plain
# `docker compose up` won't rebuild — change a value => rebuild). Only browser-safe public
# values are baked here: the Supabase URL + public anon key + the relative /api path
# (T-157-VITE — no service-role/secret keys are ever passed as build args).
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_API_BASE_URL=/api
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_API_BASE_URL=$VITE_API_BASE_URL

# Install deps. `npm ci` demands a perfectly-synced lockfile, but the committed
# package-lock.json has drifted from package.json (a transitive dep-range bump — e.g.
# @shikijs/* 4.1.0 vs 4.3.1 — that never got a lockfile regen). A dev machine with existing
# node_modules doesn't notice; alpine's fresh resolution rejects it and `npm ci` hard-fails.
# `npm install` reconciles the lockfile from package.json instead of failing. (Phase-157 build
# gap, surfaced by the Phase-158 wizard smoke. To restore `npm ci` reproducibility later,
# regenerate the lockfile cleanly: `rm package-lock.json node_modules && npm install`, commit.)
COPY package.json package-lock.json ./
RUN npm install --no-audit --no-fund

COPY . .

# Build with Vite directly. The package.json "build" script also chains `tsc -b`, which fails
# on pre-existing test-file type rot (DEPLOYMENT-LESSONS A7); vercel.json builds the same way
# ("buildCommand": "vite build"). Output dir: dist/.
RUN npx vite build

# ---- runtime stage ----
FROM nginx:1.27-alpine
# SPA static serve + /api/ SSE reverse-proxy config (retargeted to the compose `backend` service).
COPY nginx.conf /etc/nginx/conf.d/default.conf
# Copy the built SPA into nginx's default web root.
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
