// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`286-03 pin — the four load screens > broken: any other failure is the could-not-load screen, with Try again 1`] = `"<div class="flex h-full flex-col items-center justify-center gap-3 px-6 py-12 text-center"><h1 class="font-headline text-xl font-semibold text-foreground">We couldn't load this run.</h1><p class="max-w-md text-sm text-muted-foreground">Something went wrong on our side. Nothing about the run has changed.</p><div class="flex items-center gap-2"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 bg-primary text-primary-foreground hover:bg-primary/90 h-9 rounded-md px-3">Try again</button><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground h-9 rounded-md px-3">‹ Back to Workflows</button></div></div>"`;

exports[`286-03 pin — the four load screens > loading: a null id is the calm guard and reads nothing 1`] = `"<div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center"><p class="text-sm text-muted-foreground">Opening the run…</p></div>"`;

exports[`286-03 pin — the four load screens > loading: a read still in flight shows the opening line and nothing else 1`] = `"<div class="flex h-full flex-col items-center justify-center gap-3 px-6 text-center"><p class="text-sm text-muted-foreground">Opening the run…</p></div>"`;

exports[`286-03 pin — the four load screens > missing: a 404 is the not-available screen, with no Try again 1`] = `"<div class="flex h-full flex-col items-center justify-center gap-3 px-6 py-12 text-center"><h1 class="font-headline text-xl font-semibold text-foreground">This run isn't available</h1><p class="max-w-md text-sm text-muted-foreground">It may not exist, or it belongs to an organisation you're not in. Nothing about it is shown here.</p><div class="flex items-center gap-2"><button class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg]:size-4 [&amp;_svg]:shrink-0 hover:bg-accent hover:text-accent-foreground h-9 rounded-md px-3">‹ Back to Workflows</button></div></div>"`;

exports[`286-03 pin — the four load screens > ready: a non-terminal run resolves to the run surface 1`] = `"<div class="flex h-full flex-col overflow-hidden"><header class="flex shrink-0 border-b border-border/10"><div class="flex min-w-0 flex-1 flex-col gap-2 px-6 py-4"><button type="button" class="inline-flex w-fit items-center gap-1 text-sm text-muted-foreground transition-colors hover:text-foreground"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-left h-4 w-4" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>Workflows</button><div class="flex items-center gap-3"><h1 class="font-headline text-xl font-semibold leading-tight text-foreground">Supplier contract renewals</h1><span class="font-mono text-xs text-muted-foreground">v4</span><div class="ml-auto flex items-center gap-3"><div role="radiogroup" aria-label="How to view this run" data-testid="run-centre-switch" class="flex items-center gap-0.5 rounded-md border border-border/40 p-0.5"><button type="button" role="radio" aria-checked="true" data-testid="run-centre-log" class="rounded px-2 py-0.5 text-[11px] font-medium transition-colors bg-muted text-foreground">What happened</button><button type="button" role="radio" aria-checked="false" data-testid="run-centre-canvas" class="rounded px-2 py-0.5 text-[11px] font-medium transition-colors text-muted-foreground hover:text-foreground">Shape</button></div><div data-testid="run-page-stop-slot" class="flex shrink-0 items-center gap-2"><button type="button" aria-label="Stop this workflow run" data-testid="run-page-stop" class="flex shrink-0 items-center gap-1 rounded-md border border-destructive/40 bg-destructive/10 px-2 py-1 text-[11px] text-destructive transition-colors hover:bg-destructive/20 focus:outline-none focus-visible:ring-1 focus-visible:ring-ring"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square h-2.5 w-2.5 fill-current" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"></rect></svg> Stop</button></div><button type="button" class="ml-auto text-xs font-medium text-primary transition-opacity hover:opacity-80">Open the chat thread</button></div></div><div class="flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="text-xs font-semibold text-foreground">● Running</span><span class="text-xs text-muted-foreground" data-testid="run-elapsed"><span>1m 49s </span>since it started processing</span></div></div><div data-testid="run-panel-header" class="hidden w-[380px] shrink-0 items-center border-l border-border bg-card/40 px-6 py-4 lg:flex"><h2 class="text-base font-semibold text-foreground">Workflow progress</h2></div></header><div class="sr-only"><span aria-live="polite" aria-atomic="true" data-testid="run-band" class="min-w-0 truncate text-primary">● Running</span></div><div role="alert" class="sr-only" data-testid="run-alert"></div><div class="flex min-h-0 flex-1 overflow-hidden"><section aria-busy="true" data-testid="run-transcript-region" class="flex min-h-0 min-h-[320px] flex-1 flex-col overflow-y-auto px-6"><div class="mx-auto mb-6 w-full max-w-3xl"></div><div class="mx-auto mb-6 w-full max-w-3xl"><section data-testid="run-receipt" aria-label="Run receipt" class="flex min-w-0 flex-col gap-2"><p data-testid="receipt-header" class="text-[12px] font-medium leading-relaxed text-foreground"><span><span data-testid="receipt-header-atom-0">Runtime not recorded</span></span><span><span aria-hidden="true"> · </span><span data-testid="receipt-header-atom-1">3 steps</span></span><span><span aria-hidden="true"> · </span><span data-testid="receipt-header-atom-2">not finished yet</span></span></p></section></div><div class="mx-auto w-full max-w-3xl"><section data-testid="run-transcript" aria-label="Process trace" class="flex flex-col gap-2"><div data-testid="step-card-gather-contracts" data-reading="done" data-outcome="finished" class="flex flex-col rounded-xl border border-border/40 bg-card/60 transition-colors"><div class="flex w-full items-center justify-between gap-3 px-4 py-3 cursor-pointer"><div class="flex items-center gap-3 min-w-0 flex-1"><span aria-hidden="true" class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border text-xs font-semibold border-[hsl(var(--success)/0.45)] bg-[hsl(var(--success)/0.10)] text-[hsl(var(--success))]">✓</span><span data-testid="step-title" class="truncate text-sm font-medium text-foreground">Find the supplier contracts</span><span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground/80 font-normal"><span aria-hidden="true" class="text-muted-foreground/50 select-none">·</span><span data-testid="step-yield-gather-contracts">Complete</span></span></div></div></div><div data-testid="step-card-draft-letter" data-reading="running" data-outcome="still running" class="flex flex-col rounded-xl border border-border/40 bg-card/60 transition-colors"><div class="flex w-full items-center justify-between gap-3 px-4 py-3 cursor-pointer"><div class="flex items-center gap-3 min-w-0 flex-1"><span aria-hidden="true" class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border text-xs font-semibold border-accent-violet bg-accent-violet/15 text-accent-violet-text">●</span><span data-testid="step-title" class="truncate text-sm font-medium text-foreground">Draft the renewal letter</span><span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground/80 font-normal"><span aria-hidden="true" class="text-muted-foreground/50 select-none">·</span><span data-testid="step-yield-draft-letter">Running</span></span></div></div></div><div data-testid="step-card-final-check" data-reading="not-started" data-outcome="not reached" class="flex flex-col rounded-xl border border-border/40 bg-card/60 transition-colors"><div class="flex w-full items-center justify-between gap-3 px-4 py-3 cursor-pointer"><div class="flex items-center gap-3 min-w-0 flex-1"><span aria-hidden="true" class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full border text-xs font-semibold border-border/40 bg-transparent text-muted-foreground/60">○</span><span data-testid="step-title" class="truncate text-sm font-medium text-foreground">Check it over</span><span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground/80 font-normal"><span aria-hidden="true" class="text-muted-foreground/50 select-none">·</span><span data-testid="step-yield-final-check">Not started</span></span></div></div></div></section></div></section><aside data-testid="run-panel" aria-label="Run steps" class="hidden w-[380px] shrink-0 flex-col overflow-hidden border-l border-border bg-card/40 lg:flex"><div data-testid="run-spine" class="flex min-h-0 flex-1 flex-col"><div class="min-h-0 flex-1 overflow-y-auto p-6"><div class="relative"><div aria-hidden="true" data-testid="spine-rail" class="absolute bottom-4 left-[13px] top-4 z-0 w-px bg-muted-foreground/40"></div><ol class="relative z-10 flex flex-col gap-5"><li data-testid="spine-step-gather-contracts" data-reading="done" class="flex gap-4"><span aria-hidden="true" data-testid="spine-mark" class="grid h-7 w-7 shrink-0 place-items-center rounded-full border text-[13px] leading-none border-[hsl(var(--success)/0.45)] bg-[hsl(var(--success)/0.10)] text-[hsl(var(--success))]">✓</span><span class="flex min-w-0 flex-1 flex-col gap-1"><span class="flex items-baseline justify-between gap-3"><span data-testid="spine-title" class="min-w-0 truncate text-[13px] font-medium text-foreground">Find the supplier contracts</span><span data-testid="spine-duration" class="shrink-0 font-mono text-[11px] tabular-nums text-muted-foreground/70">time not recorded</span></span></span></li><li data-testid="spine-step-draft-letter" data-reading="running" class="flex gap-4"><span aria-hidden="true" data-testid="spine-mark" class="grid h-7 w-7 shrink-0 place-items-center rounded-full border text-[13px] leading-none border-accent-violet bg-accent-violet/15 text-accent-violet-text">●</span><span class="flex min-w-0 flex-1 flex-col gap-1"><span class="flex items-baseline justify-between gap-3"><span data-testid="spine-title" class="min-w-0 truncate text-[13px] font-medium text-foreground">Draft the renewal letter</span><span data-testid="spine-duration" class="shrink-0 font-mono text-[11px] tabular-nums text-muted-foreground/70">time not recorded</span></span></span></li><li data-testid="spine-step-final-check" data-reading="not-started" class="flex gap-4"><span aria-hidden="true" data-testid="spine-mark" class="grid h-7 w-7 shrink-0 place-items-center rounded-full border text-[13px] leading-none border-border/40 bg-transparent text-muted-foreground/60">○</span><span class="flex min-w-0 flex-1 flex-col gap-1"><span class="flex items-baseline justify-between gap-3"><span data-testid="spine-title" class="min-w-0 truncate text-[13px] font-medium text-muted-foreground">Check it over</span></span></span></li></ol></div></div></div></aside></div></div>"`;
