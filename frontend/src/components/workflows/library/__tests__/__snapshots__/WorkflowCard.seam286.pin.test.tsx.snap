exports[`286-04 pin — the draft delete arms first and deletes only on Confirm > Confirm with a pending delete shows the spinner and disables both buttons; resolve re-fetches once 1`] = `"<div data-testid="draft-delete-prompt" class="rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2.5"><p class="text-[13px] font-medium text-foreground">Delete this draft? It cannot be recovered.</p><div class="mt-2.5 flex items-center justify-end gap-2"><button type="button" data-testid="draft-delete-cancel" class="rounded-md border border-border px-3 py-1.5 text-[13px] text-muted-foreground transition-colors hover:bg-accent hover:text-foreground disabled:opacity-60" disabled="">Cancel</button><button type="button" data-testid="draft-delete-confirm" class="inline-flex items-center gap-1.5 rounded-md bg-destructive px-3 py-1.5 text-[13px] font-semibold text-destructive-foreground transition-colors hover:opacity-90 disabled:opacity-60" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle h-3.5 w-3.5 animate-spin" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg>Delete draft</button></div></div>"`;

exports[`286-04 pin — the draft delete arms first and deletes only on Confirm > a rejected delete is said out loud and re-fetches nothing 1`] = `"<div data-testid="draft-delete-prompt" class="rounded-md border border-destructive/30 bg-destructive/10 px-3 py-2.5"><p class="text-[13px] font-medium text-foreground">Delete this draft? It cannot be recovered.</p><div class="mt-2.5 flex items-center justify-end gap-2"><button type="button" data-testid="draft-delete-cancel" class="rounded-md border border-border px-3 py-1.5 text-[13px] text-muted-foreground transition-colors hover:bg-accent hover:text-foreground disabled:opacity-60">Cancel</button><button type="button" data-testid="draft-delete-confirm" class="inline-flex items-center gap-1.5 rounded-md bg-destructive px-3 py-1.5 text-[13px] font-semibold text-destructive-foreground transition-colors hover:opacity-90 disabled:opacity-60">Delete draft</button></div><p data-testid="draft-delete-error" role="status" class="mt-2 text-[11.5px] text-destructive">Couldn't delete this draft — try again.</p></div>"`;

