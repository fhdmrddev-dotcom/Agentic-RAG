d_src_components_chat_tool_bodies_shikicode_tsx", "target": "shikicode_shikicode", "relation": "contains", "confidence": "EXTRACTED", "source_file": "C:\\Vibe Apps\\Agentic RAG\\frontend\\src\\components\\chat\\tool-bodies\\ShikiCode.tsx", "source_location": "L103", "weight": 1.0}], "raw_calls": [{"caller_nid": "shikicode_gethighlighter", "callee": "(async () => {\r\n      try {\r\n        const shiki = await import(\"shiki\")\r\n        const hl = await shiki.createHighlighter({\r\n          themes: [\"github-dark\"],\r\n          langs: [\"python\"],\r\n        })\r\n        return {\r\n          codeToHtml: (code: string, opts: { lang: string; theme: string }) =>\r\n            hl.codeToHtml(code, opts),\r\n        }\r\n      } catch (err) {\r\n        // WR-01 fix: clear the cached rejected promise so the next mount\r\n        // retries the WASM init from scratch. Without this reset, ONE bad\r\n        // init would degrade every subsequent <ShikiCode> mount to the\r\n        // plain-pre fallback for the rest of the page session \u2014 even\r\n        // after the user is back online.\r\n        highlighterPromise = null\r\n        throw err\r\n      }\r\n    })", "source_file": "C:\\Vibe Apps\\Agentic RAG\\frontend\\src\\components\\chat\\tool-bodies\\ShikiCode.tsx", "source_location": "L54"}, {"caller_nid": "shikicode_shikicode", "callee": "useState", "source_file": "C:\\Vibe Apps\\Agentic RAG\\frontend\\src\\components\\chat\\tool-bodies\\ShikiCode.tsx", "source_location": "L104"}, {"caller_nid": "shikicode_shikicode", "callee": "useDeferredValue", "source_file": "C:\\Vibe Apps\\Agentic RAG\\frontend\\src\\components\\chat\\tool-bodies\\ShikiCode.tsx", "source_location": "L109"}, {"caller_nid": "shikicode_shikicode", "callee": "useEffect", "source_file": "C:\\Vibe Apps\\Agentic RAG\\frontend\\src\\components\\chat\\tool-bodies\\ShikiCode.tsx", "source_location": "L112"}]}