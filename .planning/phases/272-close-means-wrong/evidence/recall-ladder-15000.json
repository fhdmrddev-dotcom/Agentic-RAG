  "body_statements": {
    "exact": "SELECT dc.id, dc.document_id, dc.content, dc.chunk_index, 1 - (dc.embedding OPERATOR(public.<=>) $1) AS similarity FROM public.document_chunks dc JOIN public.documents d ON d.id = dc.document_id WHERE dc.document_id = ANY ($6) AND dc.org_id = ANY (SELECT public.current_user_org_ids()) AND ( dc.user_id = auth.uid() OR (d.folder_id IS NOT NULL AND public.folder_is_org_shared(d.folder_id)) OR public.connection_doc_is_visible(d.source_connection_id, d.ingest_visibility) ) AND (d.source_state IS NULL OR d.source_state != 'source_disconnected') AND 1 - (dc.embedding OPERATOR(public.<=>) $1) > $2 AND d.is_latest = true AND ($3 IS NULL OR d.metadata @> $3) AND ($4 IS NULL OR d.folder_id = ANY($4)) AND ($5 IS NULL OR dc.embedding_model = $5) ORDER BY (dc.embedding OPERATOR(public.<=>) $1) + 0 LIMIT $7",
    "index": "SELECT dc.id, dc.document_id, dc.content, dc.chunk_index, 1 - (dc.embedding OPERATOR(public.<=>) $1) AS similarity FROM public.document_chunks dc JOIN public.documents d ON d.id = dc.document_id WHERE dc.org_id = ANY (SELECT public.current_user_org_ids()) AND ( dc.user_id = auth.uid() OR (d.folder_id IS NOT NULL AND public.folder_is_org_shared(d.folder_id)) OR public.connection_doc_is_visible(d.source_connection_id, d.ingest_visibility) ) AND (d.source_state IS NULL OR d.source_state != 'source_disconnected') AND 1 - (dc.embedding OPERATOR(public.<=>) $1) > $2 AND d.is_latest = true AND ($3 IS NULL OR d.metadata @> $3) AND ($4 IS NULL OR d.folder_id = ANY($4)) AND ($5 IS NULL OR dc.embedding_model = $5) AND ($6 IS NULL OR dc.document_id = ANY ($6)) ORDER BY dc.embedding OPERATOR(public.<=>) $1 LIMIT $7"
  },
