"data: {\"type\": \"title\", \"content\": \"# Comprehensive Python Script: 12-Page PDF Gallery of Chart Types\\n\\n```python\\nimport\"}\r\n\r\ndata: {\"type\": \"iteration_start\", \"iteration\": 0}\r\n\r\ndata: {\"type\": \"tool_preparing\", \"name\": \"execute_code\", \"index\": 0}\r\n\r\ndata: {\"type\": \"tool_args_progress\", \"tool_index\": 0, \"name\": \"execute_code\", \"args_so_far\": \"\\\\nimport matplotlib\\\\nmatplotlib.use('Agg')\\\\nimport matplotlib.pyplot as plt\\\\nimport matplotlib.colors as mcolors\\\\nfrom matplotlib.backends.backend_pdf import PdfPages\\\\nfrom matplotlib.patches import FancyBboxPatch\\\\nimport numpy as np\\\\nfrom scipy import stats\\\\nimport os\\\\n\\\\n# \\u2500\\u2500 Global style & palette \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\nplt.rcParams.update({\\\\n    'font.family': 'DejaVu Sans',\\\\n    'axes.titlesize': 16, 'axes.titleweight': 'bold',\\\\n    'axes.labelsize': 12, 'xtick.labelsize': 10, 'ytick.labelsize': 10,\\\\n    'legend.fontsize': 10, 'figure.facecolor': '#FAFAFA',\\\\n    'axes.facecolor': '#FAFAFA', 'axes.grid': True,\\\\n    'grid.alpha': 0.3, 'grid.linestyle': '--',\\\\n})\\\\nPAL = ['#2E86AB', '#A23B72', '#F18F01', '#C73E1D', '#3B1F2B',\\\\n       '#44BBA4', '#E94F37', '#393E41', '#8ACB88', '#5E4AE3']\\\\nnp.random.seed(42)\\\\n\\\\ndef finish(fig, ax_or_axes, title_text=None):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Tighten layout; called before savefig inside PdfPages.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    fig.tight_layout(rect=[0, 0, 1, 0.95] if title_text else None)\\\\n\\\\noutput_path = '/sandbox/output/chart_gallery.pdf'\\\\nos.makedirs('/sandbox/output', exist_ok=True)\\\\n\\\\nwith PdfPages(output_path) as pdf:\\\\n\\\\n    # \\u2500\\u2500 1  Grouped Bar Chart \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    cats = ['Q1', 'Q2', 'Q3', 'Q4']\\\\n    series = {'North': [48, 55, 63, 58], 'South': [38, 42, 50, 47],\\\\n              'East': [30, 35, 45, 40], 'West': [25, 28, 38, 35]}\\\\n    x = np.arange(len(cats)); w = 0.2\\\\n    for i, (name, vals) in enumerate(series.items()):\\\\n        bars = ax.bar(x + i*w, vals, w, label=name, color=PAL[i],\\\\n                      edgecolor='white', linewidth=0.8, zorder=3)\\\\n        for b in bars:\\\\n            ax.text(b.get_x() + b.get_width()/2, b.get_height() + 1,\\\\n                    f'{b.get_height():.0f}', ha='center', va='bottom', fontsize=8, fontweight='bold')\\\\n    ax.set_xticks(x + 1.5*w); ax.set_xticklabels(cats)\\\\n    ax.set_xlabel('Quarter'); ax.set_ylabel('Revenue ($M)')\\\\n    ax.set_title('Quarterly Revenue by Region'); ax.legend(frameon=True, fancybox=True)\\\\n    ax.set_ylim(0, 75); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 2  Multi-Series Line Chart with Confidence Bands \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    months = np.arange(1, 13)\\\\n    labels_m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']\\\\n    for i, (name, base) in enumerate([('Product A', 40), ('Product B', 30), ('Product C', 20)]):\\\\n        y = base + np.cumsum(np.random.randn(12)*3)\\\\n        err = np.random.uniform(2, 5, 12)\\\\n        ax.plot(months, y, '-o', color=PAL[i], label=name, markersize=5, zorder=3)\\\\n        ax.fill_between(months, y-err, y+err, color=PAL[i], alpha=0.15)\\\\n    ax.set_xticks(months); ax.set_xticklabels(labels_m, rotation=45)\\\\n    ax.set_xlabel('Month'); ax.set_ylabel('Units Sold (k)')\\\\n    ax.set_title('Monthly Sales with 95% Confidence Bands'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 3  Scatter + Regression + Density Contours \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    n = 300\\\\n    x_s = np.random.normal(50, 12, n); y_s = 1.2*x_s + np.random.normal(0, 10, n)\\\\n    ax.scatter(x_s, y_s, c=PAL[1], alpha=0.45, edgecolors='white', linewidth=0.4, s=40, zorder=3)\\\\n    # regression\\\\n    slope, intercept, r, *_ = stats.linregress(x_s, y_s)\\\\n    xr = np.linspace(x_s.min(), x_s.max(), 100)\\\\n    ax.plot(xr, slope*xr+intercept, color=PAL[4], lw=2, label=f'Fit  R\\u00b2={r**2:.2f}')\\\\n    # density contours\\\\n    from scipy.ndimage import gaussian_filter\\\\n    h, xe, ye = np.histogram2d(x_s, y_s, bins=30)\\\\n    h = gaussian_filter(h, sigma=1.5)\\\\n    ax.contour(h.T, extent=[xe[0],xe[-1],ye[0],ye[-1]], levels=5,\\\\n               colors=PAL[5], linewidths=0.8, alpha=0.7)\\\\n    ax.set_xlabel('Study Hours'); ax.set_ylabel('Exam Score')\\\\n    ax.set_title('Study Hours vs Exam Score'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 4  Pie + Donut Combo \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, axes = plt.subplots(1, 2, figsize=(11, 7))\\\\n    labels_p = ['Desktop', 'Mobile', 'Tablet', 'Smart TV', 'Other']\\\\n    outer = [38, 32, 15, 10, 5]; inner = [30, 35, 18, 12, 5]\\\\n    axes[0].pie(outer, labels=labels_p, autopct='%1.1f%%', colors=PAL[:5],\\\\n                startangle=90, pctdistance=0.8, wedgeprops=dict(edgecolor='w', linewidth=1.5))\\\\n    axes[0].set_title('2023 Traffic Share')\\\\n    axes[1].pie(outer, labels=labels_p, autopct='%1.1f%%', colors=PAL[:5],\\\\n                startangle=90, pctdistance=0.85, radius=1,\\\\n                wedgeprops=dict(width=0.4, edgecolor='w', linewidth=1.5))\\\\n\", \"total_args_bytes_so_far\": 5130, \"code_so_far\": \"{\\\"code\\\": \\\"\\\\nimport matplotlib\\\\nmatplotlib.use('Agg')\\\\nimport matplotlib.pyplot as plt\\\\nimport matplotlib.colors as mcolors\\\\nfrom matplotlib.backends.backend_pdf import PdfPages\\\\nfrom matplotlib.patches import FancyBboxPatch\\\\nimport numpy as np\\\\nfrom scipy import stats\\\\nimport os\\\\n\\\\n# \\u2500\\u2500 Global style & palette \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\nplt.rcParams.update({\\\\n    'font.family': 'DejaVu Sans',\\\\n    'axes.titlesize': 16, 'axes.titleweight': 'bold',\\\\n    'axes.labelsize': 12, 'xtick.labelsize': 10, 'ytick.labelsize': 10,\\\\n    'legend.fontsize': 10, 'figure.facecolor': '#FAFAFA',\\\\n    'axes.facecolor': '#FAFAFA', 'axes.grid': True,\\\\n    'grid.alpha': 0.3, 'grid.linestyle': '--',\\\\n})\\\\nPAL = ['#2E86AB', '#A23B72', '#F18F01', '#C73E1D', '#3B1F2B',\\\\n       '#44BBA4', '#E94F37', '#393E41', '#8ACB88', '#5E4AE3']\\\\nnp.random.seed(42)\\\\n\\\\ndef finish(fig, ax_or_axes, title_text=None):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Tighten layout; called before savefig inside PdfPages.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    fig.tight_layout(rect=[0, 0, 1, 0.95] if title_text else None)\\\\n\\\\noutput_path = '/sandbox/output/chart_gallery.pdf'\\\\nos.makedirs('/sandbox/output', exist_ok=True)\\\\n\\\\nwith PdfPages(output_path) as pdf:\\\\n\\\\n    # \\u2500\\u2500 1  Grouped Bar Chart \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    cats = ['Q1', 'Q2', 'Q3', 'Q4']\\\\n    series = {'North': [48, 55, 63, 58], 'South': [38, 42, 50, 47],\\\\n              'East': [30, 35, 45, 40], 'West': [25, 28, 38, 35]}\\\\n    x = np.arange(len(cats)); w = 0.2\\\\n    for i, (name, vals) in enumerate(series.items()):\\\\n        bars = ax.bar(x + i*w, vals, w, label=name, color=PAL[i],\\\\n                      edgecolor='white', linewidth=0.8, zorder=3)\\\\n        for b in bars:\\\\n            ax.text(b.get_x() + b.get_width()/2, b.get_height() + 1,\\\\n                    f'{b.get_height():.0f}', ha='center', va='bottom', fontsize=8, fontweight='bold')\\\\n    ax.set_xticks(x + 1.5*w); ax.set_xticklabels(cats)\\\\n    ax.set_xlabel('Quarter'); ax.set_ylabel('Revenue ($M)')\\\\n    ax.set_title('Quarterly Revenue by Region'); ax.legend(frameon=True, fancybox=True)\\\\n    ax.set_ylim(0, 75); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 2  Multi-Series Line Chart with Confidence Bands \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    months = np.arange(1, 13)\\\\n    labels_m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']\\\\n    for i, (name, base) in enumerate([('Product A', 40), ('Product B', 30), ('Product C', 20)]):\\\\n        y = base + np.cumsum(np.random.randn(12)*3)\\\\n        err = np.random.uniform(2, 5, 12)\\\\n        ax.plot(months, y, '-o', color=PAL[i], label=name, markersize=5, zorder=3)\\\\n        ax.fill_between(months, y-err, y+err, color=PAL[i], alpha=0.15)\\\\n    ax.set_xticks(months); ax.set_xticklabels(labels_m, rotation=45)\\\\n    ax.set_xlabel('Month'); ax.set_ylabel('Units Sold (k)')\\\\n    ax.set_title('Monthly Sales with 95% Confidence Bands'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 3  Scatter + Regression + Density Contours \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    n = 300\\\\n    x_s = np.random.normal(50, 12, n); y_s = 1.2*x_s + np.random.normal(0, 10, n)\\\\n    ax.scatter(x_s, y_s, c=PAL[1], alpha=0.45, edgecolors='white', linewidth=0.4, s=40, zorder=3)\\\\n    # regression\\\\n    slope, intercept, r, *_ = stats.linregress(x_s, y_s)\\\\n    xr = np.linspace(x_s.min(), x_s.max(), 100)\\\\n    ax.plot(xr, slope*xr+intercept, color=PAL[4], lw=2, label=f'Fit  R\\u00b2={r**2:.2f}')\\\\n    # density contours\\\\n    from scipy.ndimage import gaussian_filter\\\\n    h, xe, ye = np.histogram2d(x_s, y_s, bins=30)\\\\n    h = gaussian_filter(h, sigma=1.5)\\\\n    ax.contour(h.T, extent=[xe[0],xe[-1],ye[0],ye[-1]], levels=5,\\\\n               colors=PAL[5], linewidths=0.8, alpha=0.7)\\\\n    ax.set_xlabel('Study Hours'); ax.set_ylabel('Exam Score')\\\\n    ax.set_title('Study Hours vs Exam Score'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 4  Pie + Donut Combo \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, axes = plt.subplots(1, 2, figsize=(11, 7))\\\\n    labels_p = ['Desktop', 'Mobile', 'Tablet', 'Smart TV', 'Other']\\\\n    outer = [38, 32, 15, 10, 5]; inner = [30, 35, 18, 12, 5]\\\\n    axes[0].pie(outer, labels=labels_p, autopct='%1.1f%%', colors=PAL[:5],\\\\n                startangle=90, pctdistance=0.8, wedgeprops=dict(edgecolor='w', linewidth=1.5))\\\\n    axes[0].set_title('2023 Traffic Share')\\\\n    axes[1].pie(outer, labels=labels_p, autopct='%1.1f%%', colors=PAL[:5],\\\\n                startangle=90, pctdistance=0.85, radius=1,\\\\n                wedgeprops=dict(width=0.4, edgecolor='w', linewidth=1.5))\\\\n\"}\r\n\r\ndata: {\"type\": \"tool_args_progress\", \"tool_index\": 0, \"name\": \"execute_code\", \"args_so_far\": \"es[1].pie(inner, colors=[mcolors.to_rgba(c, 0.55) for c in PAL[:5]],\\\\n                radius=0.6, startangle=90,\\\\n                wedgeprops=dict(width=0.35, edgecolor='w', linewidth=1))\\\\n    axes[1].set_title('2024 vs 2023 (inner)')\\\\n    fig.suptitle('Web Traffic by Device', fontsize=16, fontweight='bold', y=0.98)\\\\n    finish(fig, axes); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 5  Histogram + KDE Overlay \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    samples = {'Morning': np.random.normal(35, 8, 500),\\\\n               'Afternoon': np.random.normal(50, 10, 500),\\\\n               'Evening': np.random.normal(42, 7, 500)}\\\\n    for i, (lbl, data) in enumerate(samples.items()):\\\\n        ax.hist(data, bins=35, alpha=0.35, color=PAL[i], label=lbl, density=True, edgecolor='white')\\\\n        kde_x = np.linspace(data.min()-10, data.max()+10, 200)\\\\n        kde = stats.gaussian_kde(data)\\\\n        ax.plot(kde_x, kde(kde_x), color=PAL[i], lw=2)\\\\n    ax.set_xlabel('Response Time (ms)'); ax.set_ylabel('Density')\\\\n    ax.set_title('API Response Time Distribution by Time of Day'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 6  Horizontal Grouped Box Plot \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    departments = ['Engineering', 'Marketing', 'Sales', 'HR', 'Finance']\\\\n    data_box = [np.random.normal(loc, 8, 80) for loc in [72, 65, 68, 60, 70]]\\\\n    bp = ax.boxplot(data_box, vert=False, labels=departments, patch_artist=True,\\\\n                    widths=0.6, flierprops=dict(marker='o', markersize=4, alpha=0.4))\\\\n    for patch, col in zip(bp['boxes'], PAL[:5]):\\\\n        patch.set_facecolor(col); patch.set_alpha(0.7)\\\\n    for element in ['whiskers','caps','medians']:\\\\n        for item in bp[element]: item.set_color('#393E41'); item.set_linewidth(1.5)\\\\n    ax.set_xlabel('Employee Satisfaction Score'); ax.set_title('Satisfaction by Department')\\\\n    finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 7  Violin Plot \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    grps = ['Control', 'Drug A', 'Drug B', 'Drug C', 'Placebo']\\\\n    data_v = [np.random.normal(m, s, 200) for m, s in [(5,1.5),(7,2),(6.5,1.8),(8,2.5),(5.2,1.3)]]\\\\n    vp = ax.violinplot(data_v, showmeans=True, showmedians=True)\\\\n    for i, body in enumerate(vp['bodies']):\\\\n        body.set_facecolor(PAL[i]); body.set_alpha(0.7); body.set_edgecolor(PAL[i])\\\\n    for key in ['cmeans','cmedians','cbars','cmins','cmaxes']:\\\\n        vp[key].set_edgecolor('#393E41'); vp[key].set_linewidth(1.2)\\\\n    ax.set_xticks(range(1, 6)); ax.set_xticklabels(grps)\\\\n    ax.set_ylabel('Biomarker Level'); ax.set_title('Clinical Trial Biomarker Distribution')\\\\n    finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 8  Heatmap with Annotations \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']\\\\n    hours = [f'{h}:00' for h in range(8, 20)]\\\\n    heat = np.random.poisson(lam=25, size=(len(hours), len(days))) + \\\\\\\\\\\\n           np.outer(np.sin(np.linspace(0, np.pi, len(hours)))*15, np.ones(len(days)))\\\\n    im = ax.imshow(heat, cmap='YlOrRd', aspect='auto')\\\\n    ax.set_xticks(range(len(days))); ax.set_xticklabels(days)\\\\n    ax.set_yticks(range(len(hours))); ax.set_yticklabels(hours)\\\\n    for i in range(len(hours)):\\\\n        for j in range(len(days)):\\\\n            val = heat[i, j]\\\\n            color = 'white' if val > heat.max()*0.65 else 'black'\\\\n            ax.text(j, i, f'{val:.0f}', ha='center', va='center', fontsize=8, color=color)\\\\n    fig.colorbar(im, ax=ax, label='Visitors')\\\\n    ax.set_title('Hourly Visitor Traffic Heatmap'); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 9  Filled Contour Map \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    xc = np.linspace(-3, 3, 200); yc = np.linspace(-3, 3, 200)\\\\n    X, Y = np.meshgrid(xc, yc)\\\\n    Z = np.sin(X)*np.cos(Y) + np.exp(-((X-1)**2 + (Y-1)**2)/2)*2\\\\n    cs = ax.contourf(X, Y, Z, levels=20, cmap='viridis')\\\\n    ax.contour(X, Y, Z, levels=20, colors='k', linewidths=0.3, alpha=0.4)\\\\n    fig.colorbar(cs, ax=ax, label='Intensity')\\\\n    ax.set_xlabel('Longitude (normalised)'); ax.set_ylabel('Latitude (normalised)')\\\\n    ax.set_title('Geothermal Energy Potential \\u2014 Filled Contour'); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 10  3-D Surface Plot \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\", \"total_args_bytes_so_far\": 10256, \"code_so_far\": \"{\\\"code\\\": \\\"\\\\nimport matplotlib\\\\nmatplotlib.use('Agg')\\\\nimport matplotlib.pyplot as plt\\\\nimport matplotlib.colors as mcolors\\\\nfrom matplotlib.backends.backend_pdf import PdfPages\\\\nfrom matplotlib.patches import FancyBboxPatch\\\\nimport numpy as np\\\\nfrom scipy import stats\\\\nimport os\\\\n\\\\n# \\u2500\\u2500 Global style & palette \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\nplt.rcParams.update({\\\\n    'font.family': 'DejaVu Sans',\\\\n    'axes.titlesize': 16, 'axes.titleweight': 'bold',\\\\n    'axes.labelsize': 12, 'xtick.labelsize': 10, 'ytick.labelsize': 10,\\\\n    'legend.fontsize': 10, 'figure.facecolor': '#FAFAFA',\\\\n    'axes.facecolor': '#FAFAFA', 'axes.grid': True,\\\\n    'grid.alpha': 0.3, 'grid.linestyle': '--',\\\\n})\\\\nPAL = ['#2E86AB', '#A23B72', '#F18F01', '#C73E1D', '#3B1F2B',\\\\n       '#44BBA4', '#E94F37', '#393E41', '#8ACB88', '#5E4AE3']\\\\nnp.random.seed(42)\\\\n\\\\ndef finish(fig, ax_or_axes, title_text=None):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Tighten layout; called before savefig inside PdfPages.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    fig.tight_layout(rect=[0, 0, 1, 0.95] if title_text else None)\\\\n\\\\noutput_path = '/sandbox/output/chart_gallery.pdf'\\\\nos.makedirs('/sandbox/output', exist_ok=True)\\\\n\\\\nwith PdfPages(output_path) as pdf:\\\\n\\\\n    # \\u2500\\u2500 1  Grouped Bar Chart \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    cats = ['Q1', 'Q2', 'Q3', 'Q4']\\\\n    series = {'North': [48, 55, 63, 58], 'South': [38, 42, 50, 47],\\\\n              'East': [30, 35, 45, 40], 'West': [25, 28, 38, 35]}\\\\n    x = np.arange(len(cats)); w = 0.2\\\\n    for i, (name, vals) in enumerate(series.items()):\\\\n        bars = ax.bar(x + i*w, vals, w, label=name, color=PAL[i],\\\\n                      edgecolor='white', linewidth=0.8, zorder=3)\\\\n        for b in bars:\\\\n            ax.text(b.get_x() + b.get_width()/2, b.get_height() + 1,\\\\n                    f'{b.get_height():.0f}', ha='center', va='bottom', fontsize=8, fontweight='bold')\\\\n    ax.set_xticks(x + 1.5*w); ax.set_xticklabels(cats)\\\\n    ax.set_xlabel('Quarter'); ax.set_ylabel('Revenue ($M)')\\\\n    ax.set_title('Quarterly Revenue by Region'); ax.legend(frameon=True, fancybox=True)\\\\n    ax.set_ylim(0, 75); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 2  Multi-Series Line Chart with Confidence Bands \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    months = np.arange(1, 13)\\\\n    labels_m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']\\\\n    for i, (name, base) in enumerate([('Product A', 40), ('Product B', 30), ('Product C', 20)]):\\\\n        y = base + np.cumsum(np.random.randn(12)*3)\\\\n        err = np.random.uniform(2, 5, 12)\\\\n        ax.plot(months, y, '-o', color=PAL[i], label=name, markersize=5, zorder=3)\\\\n        ax.fill_between(months, y-err, y+err, color=PAL[i], alpha=0.15)\\\\n    ax.set_xticks(months); ax.set_xticklabels(labels_m, rotation=45)\\\\n    ax.set_xlabel('Month'); ax.set_ylabel('Units Sold (k)')\\\\n    ax.set_title('Monthly Sales with 95% Confidence Bands'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 3  Scatter + Regression + Density Contours \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    n = 300\\\\n    x_s = np.random.normal(50, 12, n); y_s = 1.2*x_s + np.random.normal(0, 10, n)\\\\n    ax.scatter(x_s, y_s, c=PAL[1], alpha=0.45, edgecolors='white', linewidth=0.4, s=40, zorder=3)\\\\n    # regression\\\\n    slope, intercept, r, *_ = stats.linregress(x_s, y_s)\\\\n    xr = np.linspace(x_s.min(), x_s.max(), 100)\\\\n    ax.plot(xr, slope*xr+intercept, color=PAL[4], lw=2, label=f'Fit  R\\u00b2={r**2:.2f}')\\\\n    # density contours\\\\n    from scipy.ndimage import gaussian_filter\\\\n    h, xe, ye = np.histogram2d(x_s, y_s, bins=30)\\\\n    h = gaussian_filter(h, sigma=1.5)\\\\n    ax.contour(h.T, extent=[xe[0],xe[-1],ye[0],ye[-1]], levels=5,\\\\n               colors=PAL[5], linewidths=0.8, alpha=0.7)\\\\n    ax.set_xlabel('Study Hours'); ax.set_ylabel('Exam Score')\\\\n    ax.set_title('Study Hours vs Exam Score'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 4  Pie + Donut Combo \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, axes = plt.subplots(1, 2, figsize=(11, 7))\\\\n    labels_p = ['Desktop', 'Mobile', 'Tablet', 'Smart TV', 'Other']\\\\n    outer = [38, 32, 15, 10, 5]; inner = [30, 35, 18, 12, 5]\\\\n    axes[0].pie(outer, labels=labels_p, autopct='%1.1f%%', colors=PAL[:5],\\\\n                startangle=90, pctdistance=0.8, wedgeprops=dict(edgecolor='w', linewidth=1.5))\\\\n    axes[0].set_title('2023 Traffic Share')\\\\n    axes[1].pie(outer, labels=labels_p, autopct='%1.1f%%', colors=PAL[:5],\\\\n                startangle=90, pctdistance=0.85, radius=1,\\\\n                wedgeprops=dict(width=0.4, edgecolor='w', linewidth=1.5))\\\\n    axes[1].pie(inner, colors=[mcolors.to_rgba(c, 0.55) for c in PAL[:5]],\\\\n                radius=0.6, startangle=90,\\\\n                wedgeprops=dict(width=0.35, edgecolor='w', linewidth=1))\\\\n    axes[1].set_title('2024 vs 2023 (inner)')\\\\n    fig.suptitle('Web Traffic by Device', fontsize=16, fontweight='bold', y=0.98)\\\\n    finish(fig, axes); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 5  Histogram + KDE Overlay \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    samples = {'Morning': np.random.normal(35, 8, 500),\\\\n               'Afternoon': np.random.normal(50, 10, 500),\\\\n               'Evening': np.random.normal(42, 7, 500)}\\\\n    for i, (lbl, data) in enumerate(samples.items()):\\\\n        ax.hist(data, bins=35, alpha=0.35, color=PAL[i], label=lbl, density=True, edgecolor='white')\\\\n        kde_x = np.linspace(data.min()-10, data.max()+10, 200)\\\\n        kde = stats.gaussian_kde(data)\\\\n        ax.plot(kde_x, kde(kde_x), color=PAL[i], lw=2)\\\\n    ax.set_xlabel('Response Time (ms)'); ax.set_ylabel('Density')\\\\n    ax.set_title('API Response Time Distribution by Time of Day'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 6  Horizontal Grouped Box Plot \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    departments = ['Engineering', 'Marketing', 'Sales', 'HR', 'Finance']\\\\n    data_box = [np.random.normal(loc, 8, 80) for loc in [72, 65, 68, 60, 70]]\\\\n    bp = ax.boxplot(data_box, vert=False, labels=departments, patch_artist=True,\\\\n                    widths=0.6, flierprops=dict(marker='o', markersize=4, alpha=0.4))\\\\n    for patch, col in zip(bp['boxes'], PAL[:5]):\\\\n        patch.set_facecolor(col); patch.set_alpha(0.7)\\\\n    for element in ['whiskers','caps','medians']:\\\\n        for item in bp[element]: item.set_color('#393E41'); item.set_linewidth(1.5)\\\\n    ax.set_xlabel('Employee Satisfaction Score'); ax.set_title('Satisfaction by Department')\\\\n    finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 7  Violin Plot \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    grps = ['Control', 'Drug A', 'Drug B', 'Drug C', 'Placebo']\\\\n    data_v = [np.random.normal(m, s, 200) for m, s in [(5,1.5),(7,2),(6.5,1.8),(8,2.5),(5.2,1.3)]]\\\\n    vp = ax.violinplot(data_v, showmeans=True, showmedians=True)\\\\n    for i, body in enumerate(vp['bodies']):\\\\n        body.set_facecolor(PAL[i]); body.set_alpha(0.7); body.set_edgecolor(PAL[i])\\\\n    for key in ['cmeans','cmedians','cbars','cmins','cmaxes']:\\\\n        vp[key].set_edgecolor('#393E41'); vp[key].set_linewidth(1.2)\\\\n    ax.set_xticks(range(1, 6)); ax.set_xticklabels(grps)\\\\n    ax.set_ylabel('Biomarker Level'); ax.set_title('Clinical Trial Biomarker Distribution')\\\\n    finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 8  Heatmap with Annotations \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']\\\\n    hours = [f'{h}:00' for h in range(8, 20)]\\\\n    heat = np.random.poisson(lam=25, size=(len(hours), len(days))) + \\\\\\\\\\\\n           np.outer(np.sin(np.linspace(0, np.pi, len(hours)))*15, np.ones(len(days)))\\\\n    im = ax.imshow(heat, cmap='YlOrRd', aspect='auto')\\\\n    ax.set_xticks(range(len(days))); ax.set_xticklabels(days)\\\\n    ax.set_yticks(range(len(hours))); ax.set_yticklabels(hours)\\\\n    for i in range(len(hours)):\\\\n        for j in range(len(days)):\\\\n            val = heat[i, j]\\\\n            color = 'white' if val > heat.max()*0.65 else 'black'\\\\n            ax.text(j, i, f'{val:.0f}', ha='center', va='center', fontsize=8, color=color)\\\\n    fig.colorbar(im, ax=ax, label='Visitors')\\\\n    ax.set_title('Hourly Visitor Traffic Heatmap'); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 9  Filled Contour Map \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\\\n    fig, ax = plt.subplots(figsize=(11, 7))\\\\n    xc = np.linspace(-3, 3, 200); yc = np.linspace(-3, 3, 200)\\\\n    X, Y = np.meshgrid(xc, yc)\\\\n    Z = np.sin(X)*np.cos(Y) + np.exp(-((X-1)**2 + (Y-1)**2)/2)*2\\\\n    cs = ax.contourf(X, Y, Z, levels=20, cmap='viridis')\\\\n    ax.contour(X, Y, Z, levels=20, colors='k', linewidths=0.3, alpha=0.4)\\\\n    fig.colorbar(cs, ax=ax, label='Intensity')\\\\n    ax.set_xlabel('Longitude (normalised)'); ax.set_ylabel('Latitude (normalised)')\\\\n    ax.set_title('Geothermal Energy Potential \\u2014 Filled Contour'); finish(fig, ax); pdf.savefig(fig); plt.close()\\\\n\\\\n    # \\u2500\\u2500 10  3-D Surface Plot \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\"}\r\n\r\ndata: {\"type\": \"tool_start\", \"name\": \"execute_code\", \"args\": {\"code\": \"\\nimport matplotlib\\nmatplotlib.use('Agg')\\nimport matplotlib.pyplot as plt\\nimport matplotlib.colors as mcolors\\nfrom matplotlib.backends.backend_pdf import PdfPages\\nfrom matplotlib.patches import FancyBboxPatch\\nimport numpy as np\\nfrom scipy import stats\\nimport os\\n\\n# \\u2500\\u2500 Global style & palette \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\nplt.rcParams.update({\\n    'font.family': 'DejaVu Sans',\\n    'axes.titlesize': 16, 'axes.titleweight': 'bold',\\n    'axes.labelsize': 12, 'xtick.labelsize': 10, 'ytick.labelsize': 10,\\n    'legend.fontsize': 10, 'figure.facecolor': '#FAFAFA',\\n    'axes.facecolor': '#FAFAFA', 'axes.grid': True,\\n    'grid.alpha': 0.3, 'grid.linestyle': '--',\\n})\\nPAL = ['#2E86AB', '#A23B72', '#F18F01', '#C73E1D', '#3B1F2B',\\n       '#44BBA4', '#E94F37', '#393E41', '#8ACB88', '#5E4AE3']\\nnp.random.seed(42)\\n\\ndef finish(fig, ax_or_axes, title_text=None):\\n    \\\"\\\"\\\"Tighten layout; called before savefig inside PdfPages.\\\"\\\"\\\"\\n    fig.tight_layout(rect=[0, 0, 1, 0.95] if title_text else None)\\n\\noutput_path = '/sandbox/output/chart_gallery.pdf'\\nos.makedirs('/sandbox/output', exist_ok=True)\\n\\nwith PdfPages(output_path) as pdf:\\n\\n    # \\u2500\\u2500 1  Grouped Bar Chart \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(11, 7))\\n    cats = ['Q1', 'Q2', 'Q3', 'Q4']\\n    series = {'North': [48, 55, 63, 58], 'South': [38, 42, 50, 47],\\n              'East': [30, 35, 45, 40], 'West': [25, 28, 38, 35]}\\n    x = np.arange(len(cats)); w = 0.2\\n    for i, (name, vals) in enumerate(series.items()):\\n        bars = ax.bar(x + i*w, vals, w, label=name, color=PAL[i],\\n                      edgecolor='white', linewidth=0.8, zorder=3)\\n        for b in bars:\\n            ax.text(b.get_x() + b.get_width()/2, b.get_height() + 1,\\n                    f'{b.get_height():.0f}', ha='center', va='bottom', fontsize=8, fontweight='bold')\\n    ax.set_xticks(x + 1.5*w); ax.set_xticklabels(cats)\\n    ax.set_xlabel('Quarter'); ax.set_ylabel('Revenue ($M)')\\n    ax.set_title('Quarterly Revenue by Region'); ax.legend(frameon=True, fancybox=True)\\n    ax.set_ylim(0, 75); finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 2  Multi-Series Line Chart with Confidence Bands \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(11, 7))\\n    months = np.arange(1, 13)\\n    labels_m = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']\\n    for i, (name, base) in enumerate([('Product A', 40), ('Product B', 30), ('Product C', 20)]):\\n        y = base + np.cumsum(np.random.randn(12)*3)\\n        err = np.random.uniform(2, 5, 12)\\n        ax.plot(months, y, '-o', color=PAL[i], label=name, markersize=5, zorder=3)\\n        ax.fill_between(months, y-err, y+err, color=PAL[i], alpha=0.15)\\n    ax.set_xticks(months); ax.set_xticklabels(labels_m, rotation=45)\\n    ax.set_xlabel('Month'); ax.set_ylabel('Units Sold (k)')\\n    ax.set_title('Monthly Sales with 95% Confidence Bands'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 3  Scatter + Regression + Density Contours \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(11, 7))\\n    n = 300\\n    x_s = np.random.normal(50, 12, n); y_s = 1.2*x_s + np.random.normal(0, 10, n)\\n    ax.scatter(x_s, y_s, c=PAL[1], alpha=0.45, edgecolors='white', linewidth=0.4, s=40, zorder=3)\\n    # regression\\n    slope, intercept, r, *_ = stats.linregress(x_s, y_s)\\n    xr = np.linspace(x_s.min(), x_s.max(), 100)\\n    ax.plot(xr, slope*xr+intercept, color=PAL[4], lw=2, label=f'Fit  R\\u00b2={r**2:.2f}')\\n    # density contours\\n    from scipy.ndimage import gaussian_filter\\n    h, xe, ye = np.histogram2d(x_s, y_s, bins=30)\\n    h = gaussian_filter(h, sigma=1.5)\\n    ax.contour(h.T, extent=[xe[0],xe[-1],ye[0],ye[-1]], levels=5,\\n               colors=PAL[5], linewidths=0.8, alpha=0.7)\\n    ax.set_xlabel('Study Hours'); ax.set_ylabel('Exam Score')\\n    ax.set_title('Study Hours vs Exam Score'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 4  Pie + Donut Combo \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, axes = plt.subplots(1, 2, figsize=(11, 7))\\n    labels_p = ['Desktop', 'Mobile', 'Tablet', 'Smart TV', 'Other']\\n    outer = [38, 32, 15, 10, 5]; inner = [30, 35, 18, 12, 5]\\n    axes[0].pie(outer, labels=labels_p, autopct='%1.1f%%', colors=PAL[:5],\\n                startangle=90, pctdistance=0.8, wedgeprops=dict(edgecolor='w', linewidth=1.5))\\n    axes[0].set_title('2023 Traffic Share')\\n    axes[1].pie(outer, labels=labels_p, autopct='%1.1f%%', colors=PAL[:5],\\n                startangle=90, pctdistance=0.85, radius=1,\\n                wedgeprops=dict(width=0.4, edgecolor='w', linewidth=1.5))\\n    axes[1].pie(inner, colors=[mcolors.to_rgba(c, 0.55) for c in PAL[:5]],\\n                radius=0.6, startangle=90,\\n                wedgeprops=dict(width=0.35, edgecolor='w', linewidth=1))\\n    axes[1].set_title('2024 vs 2023 (inner)')\\n    fig.suptitle('Web Traffic by Device', fontsize=16, fontweight='bold', y=0.98)\\n    finish(fig, axes); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 5  Histogram + KDE Overlay \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(11, 7))\\n    samples = {'Morning': np.random.normal(35, 8, 500),\\n               'Afternoon': np.random.normal(50, 10, 500),\\n               'Evening': np.random.normal(42, 7, 500)}\\n    for i, (lbl, data) in enumerate(samples.items()):\\n        ax.hist(data, bins=35, alpha=0.35, color=PAL[i], label=lbl, density=True, edgecolor='white')\\n        kde_x = np.linspace(data.min()-10, data.max()+10, 200)\\n        kde = stats.gaussian_kde(data)\\n        ax.plot(kde_x, kde(kde_x), color=PAL[i], lw=2)\\n    ax.set_xlabel('Response Time (ms)'); ax.set_ylabel('Density')\\n    ax.set_title('API Response Time Distribution by Time of Day'); ax.legend(); finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 6  Horizontal Grouped Box Plot \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(11, 7))\\n    departments = ['Engineering', 'Marketing', 'Sales', 'HR', 'Finance']\\n    data_box = [np.random.normal(loc, 8, 80) for loc in [72, 65, 68, 60, 70]]\\n    bp = ax.boxplot(data_box, vert=False, labels=departments, patch_artist=True,\\n                    widths=0.6, flierprops=dict(marker='o', markersize=4, alpha=0.4))\\n    for patch, col in zip(bp['boxes'], PAL[:5]):\\n        patch.set_facecolor(col); patch.set_alpha(0.7)\\n    for element in ['whiskers','caps','medians']:\\n        for item in bp[element]: item.set_color('#393E41'); item.set_linewidth(1.5)\\n    ax.set_xlabel('Employee Satisfaction Score'); ax.set_title('Satisfaction by Department')\\n    finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 7  Violin Plot \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(11, 7))\\n    grps = ['Control', 'Drug A', 'Drug B', 'Drug C', 'Placebo']\\n    data_v = [np.random.normal(m, s, 200) for m, s in [(5,1.5),(7,2),(6.5,1.8),(8,2.5),(5.2,1.3)]]\\n    vp = ax.violinplot(data_v, showmeans=True, showmedians=True)\\n    for i, body in enumerate(vp['bodies']):\\n        body.set_facecolor(PAL[i]); body.set_alpha(0.7); body.set_edgecolor(PAL[i])\\n    for key in ['cmeans','cmedians','cbars','cmins','cmaxes']:\\n        vp[key].set_edgecolor('#393E41'); vp[key].set_linewidth(1.2)\\n    ax.set_xticks(range(1, 6)); ax.set_xticklabels(grps)\\n    ax.set_ylabel('Biomarker Level'); ax.set_title('Clinical Trial Biomarker Distribution')\\n    finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 8  Heatmap with Annotations \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(11, 7))\\n    days = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun']\\n    hours = [f'{h}:00' for h in range(8, 20)]\\n    heat = np.random.poisson(lam=25, size=(len(hours), len(days))) + \\\\\\n           np.outer(np.sin(np.linspace(0, np.pi, len(hours)))*15, np.ones(len(days)))\\n    im = ax.imshow(heat, cmap='YlOrRd', aspect='auto')\\n    ax.set_xticks(range(len(days))); ax.set_xticklabels(days)\\n    ax.set_yticks(range(len(hours))); ax.set_yticklabels(hours)\\n    for i in range(len(hours)):\\n        for j in range(len(days)):\\n            val = heat[i, j]\\n            color = 'white' if val > heat.max()*0.65 else 'black'\\n            ax.text(j, i, f'{val:.0f}', ha='center', va='center', fontsize=8, color=color)\\n    fig.colorbar(im, ax=ax, label='Visitors')\\n    ax.set_title('Hourly Visitor Traffic Heatmap'); finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 9  Filled Contour Map \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(11, 7))\\n    xc = np.linspace(-3, 3, 200); yc = np.linspace(-3, 3, 200)\\n    X, Y = np.meshgrid(xc, yc)\\n    Z = np.sin(X)*np.cos(Y) + np.exp(-((X-1)**2 + (Y-1)**2)/2)*2\\n    cs = ax.contourf(X, Y, Z, levels=20, cmap='viridis')\\n    ax.contour(X, Y, Z, levels=20, colors='k', linewidths=0.3, alpha=0.4)\\n    fig.colorbar(cs, ax=ax, label='Intensity')\\n    ax.set_xlabel('Longitude (normalised)'); ax.set_ylabel('Latitude (normalised)')\\n    ax.set_title('Geothermal Energy Potential \\u2014 Filled Contour'); finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 10  3-D Surface Plot \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig = plt.figure(figsize=(11, 7))\\n    ax = fig.add_subplot(111, projection='3d')\\n    xs = np.linspace(-4, 4, 120); ys = np.linspace(-4, 4, 120)\\n    X3, Y3 = np.meshgrid(xs, ys)\\n    Z3 = np.sin(np.sqrt(X3**2 + Y3**2)) * np.exp(-0.1*(X3**2 + Y3**2))\\n    ax.plot_surface(X3, Y3, Z3, cmap='coolwarm', edgecolor='none', alpha=0.92)\\n    ax.set_xlabel('X'); ax.set_ylabel('Y'); ax.set_zlabel('Amplitude')\\n    ax.set_title('Damped Radial Wave \\u2014 3D Surface', pad=20)\\n    ax.view_init(elev=30, azim=225); finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 11  Polar / Radar Chart \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(9, 9), subplot_kw=dict(polar=True))\\n    attrs = ['Speed', 'Strength', 'Agility', 'Endurance', 'Accuracy', 'Teamwork']\\n    angles = np.linspace(0, 2*np.pi, len(attrs), endpoint=False).tolist()\\n    angles += angles[:1]  # close\\n    for i, (player, vals) in enumerate([\\n        ('Player A', [85, 70, 90, 75, 80, 88]),\\n        ('Player B', [70, 88, 65, 82, 75, 72]),\\n        ('Player C', [78, 75, 80, 90, 68, 85])]):\\n        vals_c = vals + vals[:1]\\n        ax.plot(angles, vals_c, 'o-', color=PAL[i], label=player, linewidth=2, markersize=5)\\n        ax.fill(angles, vals_c, color=PAL[i], alpha=0.12)\\n    ax.set_thetagrids(np.degrees(angles[:-1]), attrs)\\n    ax.set_ylim(0, 100); ax.set_title('Player Attribute Comparison \\u2014 Radar', pad=30)\\n    ax.legend(loc='upper right', bbox_to_anchor=(1.25, 1.1)); finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\n    # \\u2500\\u2500 12  Stacked Area Chart \\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\n    fig, ax = plt.subplots(figsize=(11, 7))\\n    years = np.arange(2015, 2025)\\n    sources = {'Solar': np.array([5,8,12,18,25,33,42,52,65,80]),\\n               'Wind':  np.array([20,22,25,30,35,40,48,55,60,68]),\\n               'Hydro': np.array([40,40,39,38,37,36,35,34,33,32]),\\n               'Nuclear':np.array([30,29,28,27,26,25,24,23,22,21]),\\n               'Fossil': np.array([120,115,108,100,90,78,65,52,40,28])}\\n    ax.stackplot(years, sources.values(), labels=sources.keys(),\\n                 colors=PAL[:5], alpha=0.85, edgecolor='white', linewidth=0.5)\\n    ax.set_xlabel('Year'); ax.set_ylabel('Energy Output (TWh)')\\n    ax.set_title('Energy Mix Evolution 2015-2024')\\n    ax.legend(loc='upper left', frameon=True); ax.set_xlim(2015, 2024)\\n    finish(fig, ax); pdf.savefig(fig); plt.close()\\n\\nprint(f'\\u2705  PDF saved  \\u2192  {output_path}')\\nimport subprocess\\nsubprocess.run(['ls', '-la', output_path])\\n\", \"libraries\": [\"matplotlib