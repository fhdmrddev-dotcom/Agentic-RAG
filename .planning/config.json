{
  "workflow": {
    "_auto_chain_active": false,
    "research": true,
    "plan_check": true,
    "verifier": true,
    "pattern_mapper": true,
    "nyquist_validation": false,
    "ui_phase": true,
    "ui_safety_gate": true,
    "ai_integration_phase": true,
    "tdd_mode": true,
    "code_review": true,
    "code_review_depth": "standard",
    "ui_review": true,
    "auto_advance": false,
    "skip_discuss": false,
    "use_worktrees": true,
    "worktree_bootstrap": "scripts/bootstrap-worktree.sh",
    "research_before_questions": false,
    "post_planning_gaps": false,
    "security_enforcement": true,
    "inline_plan_threshold": 4
  },
  "model_profile": "quality",
  "commit_docs": true,
  "git": {
    "branching_strategy": "none",
    "base_branch": "master"
  },
  "hooks": {
    "context_warnings": true
  },
  "intel": {
    "enabled": false
  },
  "graphify": {
    "enabled": true
  }
}
