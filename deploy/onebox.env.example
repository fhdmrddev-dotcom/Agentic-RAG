# ============================================================
# Agentic RAG — ONE-BOX self-host preset (home B)
# ============================================================
# A curated, filled-in copy of backend/.env.example carrying the one-box
# baseline (D-06). Every key here also lives in backend/.env.example, EXCEPT the
# documented gaps the app reads but the base file omits: FRONTEND_URL,
# ENVIRONMENT, and the VITE_* build-time vars.
#
# This productizes the architectural fact that local ↔ cloud ↔ on-prem is a
# pure env-var switch — the SAME image, a different .env. Scale (WORKER_COUNT,
# pool size, Redis memory) is a dial turned inside this home, not a new product.
# ============================================================
# USAGE (home B — one `docker compose up`)
# ------------------------------------------------------------
#   1. From the repo root:  cp deploy/onebox.env.example ./.env
#      (the root ./.env is gitignored — your real secrets live ONLY there, never
#       in this committed template.)
#   2. Fill in: the Supabase URL + keys, POSTGRES_DSN, ONE provider key
#      (OPENAI_API_KEY), OPERATOR_EMAILS, and SECRETS_ENCRYPTION_KEY.
#      Generate the encryption key with:
#        python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   3. Bring the stack up (builds the nginx frontend + backend + bundled Redis):
#        docker compose -f docker-compose.prod.yml up -d --build
#      NOTE: VITE_* are baked at BUILD time — changing one needs a rebuild
#      (re-run with --build); a plain `up` will not pick the new value up.
# ============================================================


# ─────────────────────────────────────────────────────────────────────────────
# Supabase (ALWAYS external cloud — never bundled in the compose, D-02)
# ─────────────────────────────────────────────────────────────────────────────
# The cloud project URL. For a real deploy the browser (VITE_SUPABASE_URL, at the
# bottom of this file) and the backend runtime use the SAME https URL.
#   (LOCAL D-09 smoke only: browser and backend reach a local Supabase at
#    DIFFERENT URLs — see the LOCAL-SMOKE note in the "Frontend build-time" block.)
SUPABASE_URL=https://<project-ref>.supabase.co

# Auth keys — paste from the Supabase dashboard (Settings → API). Placeholders only.
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_SECRET_KEY=<supabase-secret-key>

# SSO — SAML 2.0 (Phase 168) provider-CRUD transport (config, NOT secrets). Only needed if an
# org-admin will register a SAML IdP. The default Cloud path uses the Management API; the sbp_
# token itself is NOT an env var — seed it once into app_settings.supabase_management_token
# (encrypted at rest by SECRETS_ENCRYPTION_KEY). See docs/OPERATOR.md.
#   SUPABASE_PROJECT_REF — Dashboard → Project Settings → General → Reference ID (the <project-ref>).
#   SUPABASE_SELF_HOSTED — false = Cloud Management API (default). true = self-hosted GoTrue Admin
#                          API (authed by SUPABASE_SERVICE_ROLE_KEY; no management token needed).
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_SELF_HOSTED=false


# ─────────────────────────────────────────────────────────────────────────────
# Operator role (Phase 146 — ADMIN-01) — the REAL /admin access control
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated; your own email bootstraps you as operator on first boot. This
# is the access gate — NOT ENVIRONMENT (see below).
OPERATOR_EMAILS=<your-operator-email@example.com>


# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
# WORKER_COUNT is a scale DIAL turned inside this home (D-04), not a separate
# product — drop to 1 on a 1-vCPU box, raise it on bigger hardware. 2 is validated.
WORKER_COUNT=2

# Phase 204 (SCHED-01) — the background workflow SCHEDULER. OFF by default: it starts
# REAL runs unattended, so it is opt-in on a fresh box. Safe to enable at any
# WORKER_COUNT — the claim is a database transaction, not an in-process lock, so every
# worker can poll and a schedule still fires exactly once.
SCHEDULER_PROCESS_ENABLED=false
SCHEDULER_POLL_INTERVAL_SECONDS=60
SCHEDULER_MAX_CLAIMS_PER_TICK=10

# Phase 230 (QUEUE-01 / QUEUE-05) — the durable ingestion queue daemon.
# Enabled by default: background worker processes uploads asynchronously with
# concurrency bounding, restart recovery, and rate-limit backoff.
INGEST_WORKER_ENABLED=true
INGEST_MAX_CONCURRENT_JOBS=3
INGEST_POLL_INTERVAL_SECONDS=2.0
INGEST_LEASE_TIMEOUT_SECONDS=300


# ─────────────────────────────────────────────────────────────────────────────
# Redis (BUNDLED in docker-compose.prod.yml — ephemeral, 256 MB LRU)
# ─────────────────────────────────────────────────────────────────────────────
# The bundled compose service is named `redis`; the backend reaches it over the
# compose network. (Using MANAGED Redis instead? Use rediss:// TLS — LESSONS A5.)
REDIS_URL=redis://redis:6379


# ─────────────────────────────────────────────────────────────────────────────
# asyncpg pool — direct Postgres (hot-path I/O)
# ─────────────────────────────────────────────────────────────────────────────
# Use the SESSION pooler on :5432 (IPv4) — NOT the direct db.<ref> host (IPv6-only,
# unreachable from the container) and NOT the :6543 transaction pooler (breaks
# asyncpg prepared statements). LESSONS A4. Embeds the DB password — placeholder only.
POSTGRES_DSN=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10


# ─────────────────────────────────────────────────────────────────────────────
# Deploy topology — vars the app READS but backend/.env.example OMITS (gaps)
# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND_URL — CORS allow-list, comma-split multi-origin (LESSONS B1). List EVERY
# browser origin and match the published nginx port / your real domain(s).
#   real-deploy example: FRONTEND_URL=https://app.example.com,https://www.example.com
FRONTEND_URL=http://localhost:8080

# Where a THIRD PARTY reaches this API from a browser. Used for the OAuth
# redirect_uri only. It must NOT be FRONTEND_URL: the callback is a backend route
# (GET /connectors/oauth/callback) and the frontend has no router or proxy for it.
# This value must match the Authorised redirect URI registered in the provider's
# console EXACTLY, or the exchange fails with redirect_uri_mismatch.
BACKEND_PUBLIC_URL=http://localhost:8000

# ── The install-wide OAuth application, one per provider (Phase 215 + 2026-08-31) ──
# Register the app once in the provider's console, put its id and secret here, and every
# user just presses "Connect with <service>" — no per-connection credentials.
#
# The Authorised redirect URI to register is BACKEND_PUBLIC_URL + /connectors/oauth/callback
#   local default: http://localhost:8000/connectors/oauth/callback
#
# A connection MAY still bring its own pair through the form's Advanced section; that
# overrides these. Leave blank to require it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# ENVIRONMENT — deploy marker only. As of Phase 146 it NO LONGER gates /admin
# (OPERATOR_EMAILS + the operator_users table do). Set for cleanliness.
ENVIRONMENT=production


# ─────────────────────────────────────────────────────────────────────────────
# LLM providers
# ─────────────────────────────────────────────────────────────────────────────
# Default chat provider. One-box ships with OpenAI; set a different key +
# LLM_PROVIDER to switch (anthropic | google | openrouter | ollama).
LLM_PROVIDER=openai

# Set the ONE provider key you intend to use. The others are optional.
OPENAI_API_KEY=sk-<your-openai-key>
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Pin known-good model IDs per env — a model that works locally can 404 on cloud
# keys (LESSONS B3). Keep in sync with MODEL_CAPABILITIES.
OPENAI_MODELS=gpt-4o,gpt-4o-mini,gpt-4.1,gpt-4.1-mini


# ─────────────────────────────────────────────────────────────────────────────
# Secrets at rest (Phase 150 — SEC-01)
# ─────────────────────────────────────────────────────────────────────────────
# Fernet key that encrypts the provider/secret keys stored in app_settings.
#   - BLANK (default): fail-open — secrets stay PLAINTEXT + a loud startup warning.
#   - valid key: encrypted at rest (an idempotent boot sweep encrypts existing rows).
#   - MALFORMED key: the backend REFUSES TO START.
# Generate a key (never commit a real one):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Embeddings
# ─────────────────────────────────────────────────────────────────────────────
# Falls back to the LLM provider key (OPENAI_API_KEY) when EMBEDDING_API_KEY is blank.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model's output dimension (1536 = text-embedding-3-small).
# Changing it later requires resize_embedding_column + full re-ingestion.
EMBEDDING_DIMENSIONS=1536


# ─────────────────────────────────────────────────────────────────────────────
# Retrieval & chunking (defaults carried from backend/.env.example)
# ─────────────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_MATCH_THRESHOLD=0.3
CHUNK_SIZE=1000
CHUNK_OVERLAP=200


# ─────────────────────────────────────────────────────────────────────────────
# Hybrid search & reranking
# ─────────────────────────────────────────────────────────────────────────────
HYBRID_SEARCH_ENABLED=true
HYBRID_CANDIDATE_COUNT=20
VECTOR_SEARCH_WEIGHT=1.0
KEYWORD_SEARCH_WEIGHT=1.0
RRF_K=60

# RERANK_ENABLED=false for the one-box: reranking pulls in torch/sentence-transformers
# (~2 GB) which the cloud backend image intentionally drops — this keeps the box ~4 GB.
# The knobs below stay inert while disabled.
RERANK_ENABLED=false
# RERANK_PROVIDER=cohere
# RERANK_API_KEY=
# RERANK_MODEL=rerank-v3.5
# RERANK_TOP_N=5


# ─────────────────────────────────────────────────────────────────────────────
# Code execution sandbox
# ─────────────────────────────────────────────────────────────────────────────
# execute_code runs in sibling Docker containers. The backend service mounts
# /var/run/docker.sock (host root → SINGLE-TENANT boxes only). Build the image once
# on the host so it is not pulled at runtime (LESSONS B2):
#   docker build -f backend/Dockerfile.sandbox -t agentic-rag-sandbox:101.1 backend/
# The -t build tag and SANDBOX_IMAGE MUST be identical.
SANDBOX_ENABLED=true
SANDBOX_IMAGE=agentic-rag-sandbox:101.1


# ─────────────────────────────────────────────────────────────────────────────
# Invitation email delivery (Phase 167 — INV-01, D-167-02)
# ─────────────────────────────────────────────────────────────────────────────
# Default `none`: the app LOGS the invite link (no email service / API key needed — the
# org-admin copies + shares it). Set EMAIL_PROVIDER=resend + RESEND_API_KEY +
# INVITE_FROM_EMAIL to send real email (opt-in; the link base reuses FRONTEND_URL).
EMAIL_PROVIDER=none
# RESEND_API_KEY=
# INVITE_FROM_EMAIL=


# ─────────────────────────────────────────────────────────────────────────────
# Optional integrations (leave unset unless you use them)
# ─────────────────────────────────────────────────────────────────────────────
# Tavily web search:
TAVILY_API_KEY=
# LangSmith tracing (self-host default: off — no account needed; uncomment to enable):
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-rag
# LANGSMITH_TRACING=true
# PDF/DOCX extraction subprocess timeout (seconds):
PYMUPDF_TIMEOUT_S=60

# Background connector watch loop (Phase 234 — LIB-08 / QUEUE-03)
WATCH_PROCESS_ENABLED=false
WATCH_POLL_INTERVAL_SECONDS=60



# ─────────────────────────────────────────────────────────────────────────────
# Frontend BUILD-TIME vars (VITE_*) — BUILD ARGS, *NOT* runtime env
# ─────────────────────────────────────────────────────────────────────────────
# Vite inlines these into the JS bundle at BUILD time. The compose passes them as
# frontend build.args (interpolated from the root ./.env). A plain `up` will NOT
# pick up changes — rebuild the frontend when a VITE_* value changes.
# For a real deploy VITE_SUPABASE_URL == SUPABASE_URL (the same https URL).
#
# LOCAL D-09 SMOKE ONLY — browser and backend reach a LOCAL Supabase at DIFFERENT
# URLs (two network vantage points onto the same instance):
#   browser build arg : VITE_SUPABASE_URL=http://127.0.0.1:54321
#   backend runtime   : SUPABASE_URL=http://host.docker.internal:54321
#                       POSTGRES_DSN=postgresql://postgres:postgres@host.docker.internal:54322/postgres
#   (the backend container reaches the host's local Supabase via host.docker.internal;
#    the browser on the host reaches it at 127.0.0.1. For cloud, both are the https URL.)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
VITE_API_BASE_URL=/api

# Phase 226: Public Landing Page CTAs
# VITE_DEMO_URL: External URL for booking demos (e.g. Google Calendar appointment page). If empty, CTA defaults to internal anchor (#start).
VITE_DEMO_URL=
# VITE_APP_URL: Base URL of the application SPA (e.g. https://app.example.com). If empty, Sign In links default to relative /app.
VITE_APP_URL=

