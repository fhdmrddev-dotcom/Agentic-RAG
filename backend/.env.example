# ============================================================
# Agentic RAG — Backend environment variables
# ============================================================
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env (it's gitignored).
#
# Local-vs-cloud switch: change SUPABASE_URL + REDIS_URL only.
# All other secrets are provider keys; they don't change between envs.
# ============================================================


# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Local (default — `supabase start` provides these):
#   SUPABASE_URL=http://127.0.0.1:54321
# Cloud:
#   SUPABASE_URL=https://<project-ref>.supabase.co

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_URL=http://127.0.0.1:54321

# Convenience aliases — most code uses SUPABASE_URL + a path suffix
SUPABASE_REST_URL=
SUPABASE_GRAPHQL_URL=
SUPABASE_FUNCTIONS_URL=

# Direct Postgres connection (used by migrations + admin scripts, not the runtime)
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Auth keys — local CLI defaults are fine for local; rotate for cloud
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Storage (S3-compatible)
SUPABASE_STORAGE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Local dev tools (Supabase CLI)
SUPABASE_STUDIO_URL=
SUPABASE_MAILPIT_URL=
SUPABASE_MCP_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Redis (v2.5+ — run-backed streaming buffer; see Phase 061 / D-v2.5-08)
# ─────────────────────────────────────────────────────────────────────────────
# Local (default — `docker compose -f docker-compose.dev.yml up -d`):
#   REDIS_URL=redis://localhost:6379
# Cloud (Upstash example — note rediss:// for TLS):
#   REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

REDIS_URL=redis://localhost:6379


# ─────────────────────────────────────────────────────────────────────────────
# LLM providers
# ─────────────────────────────────────────────────────────────────────────────
# Default provider for chat. One of: openai | anthropic | google | openrouter | ollama
LLM_PROVIDER=openai

# Provider API keys — set whichever providers you intend to use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama runs locally — no key needed
OLLAMA_BASE_URL=http://localhost:11434

# Per-provider model lists (comma-separated). Drives the Settings UI dropdowns.
# Keep these in sync with MODEL_CAPABILITIES; pick current real model IDs.
OPENAI_MODELS=gpt-4o,gpt-4o-mini,gpt-4.1,gpt-4.1-mini
ANTHROPIC_MODELS=claude-opus-4-7,claude-sonnet-4-6,claude-haiku-4-5-20251001
GOOGLE_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite
OPENROUTER_MODELS=
OLLAMA_MODELS=llama3.2,mistral


# ─────────────────────────────────────────────────────────────────────────────
# Embeddings (used by ingestion + retrieval)
# ─────────────────────────────────────────────────────────────────────────────
# Falls back to LLM provider key if EMBEDDING_API_KEY is empty
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Must match your embedding model output dimension.
# 1536 = OpenAI text-embedding-3-small | 768 = nomic-embed-text | 384 = MiniLM-L6
# Changing this requires resize_embedding_column + full re-ingestion
EMBEDDING_DIMENSIONS=1536


# ─────────────────────────────────────────────────────────────────────────────
# Retrieval & chunking
# ─────────────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_MATCH_THRESHOLD=0.3
CHUNK_SIZE=1000
CHUNK_OVERLAP=200


# ─────────────────────────────────────────────────────────────────────────────
# Hybrid search & reranking
# ─────────────────────────────────────────────────────────────────────────────
HYBRID_SEARCH_ENABLED=true
HYBRID_CANDIDATE_COUNT=20
VECTOR_SEARCH_WEIGHT=1.0
KEYWORD_SEARCH_WEIGHT=1.0
RRF_K=60

RERANK_ENABLED=false
RERANK_PROVIDER=cohere
RERANK_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_TOP_N=5


# ─────────────────────────────────────────────────────────────────────────────
# Web search (Tavily)
# ─────────────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5


# ─────────────────────────────────────────────────────────────────────────────
# Observability (LangSmith)
# ─────────────────────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag
LANGSMITH_TRACING=true


# ─────────────────────────────────────────────────────────────────────────────
# Code execution sandbox
# ─────────────────────────────────────────────────────────────────────────────
# Requires Docker + the llm-sandbox image. Set false to disable code-execution tool.
SANDBOX_ENABLED=true


# ─────────────────────────────────────────────────────────────────────────────
# PDF/DOCX extraction (Phase 071)
# ─────────────────────────────────────────────────────────────────────────────
# EXTRACTOR_PRIMARY: which engine new uploads use. Values: docling | pymupdf | legacy.
# Default 'docling' — layout-aware structured extraction (D-071-12).
# Use POST /documents/{id}/reextract to override per-document without flipping global.
EXTRACTOR_PRIMARY=docling

# PYMUPDF_TIMEOUT_S: subprocess timeout for the AGPL-fenced PyMuPDF child (D-071-03).
# On timeout, child is SIGKILL'd and caller raises ExtractionError("pymupdf timed out after Ns").
PYMUPDF_TIMEOUT_S=60

# EXTRACTOR_DOCLING_TIMEOUT_S: Docling per-document timeout in seconds (D-071.1-02).
# Drives both (a) PdfPipelineOptions.document_timeout (checked at batch boundaries
# inside the pipeline) AND (b) the wall-clock asyncio.wait_for fail-safe at the
# /reextract route (which adds a +10s buffer over this value). The wall-clock layer
# catches Docling stalls that wedge in native code (e.g., TableFormer/layout-
# prediction) before Docling itself can check its own timeout. Trade-off
# (D-v2.5-02 single-worker): the wall-clock layer cannot kill the underlying
# thread — one stuck thread per stuck call until uvicorn restart.
EXTRACTOR_DOCLING_TIMEOUT_S=120

# EXTRACTOR_DOCLING_DISABLE_TABLE_STRUCTURE: bool — when truthy, sets
# PdfPipelineOptions.do_table_structure=False. Lets operators fall back to
# "pdfium-only" mode on PDFs that wedge in TableFormer. Trade-off: tables become
# text-only chunks instead of structured TableData rows. Default false (full
# TableFormer enabled). Truthy values: 1, true, yes.
EXTRACTOR_DOCLING_DISABLE_TABLE_STRUCTURE=false

# EXTRACTOR_DOCLING_IMAGES_SCALE: float — PdfPipelineOptions.images_scale. Lower
# values (e.g., 1.0 or 0.5) reduce memory pressure on big PDFs by producing
# smaller rendered page images for figure extraction. Default 2.0 (matches the
# pre-071.1 hardcoded value).
EXTRACTOR_DOCLING_IMAGES_SCALE=2.0
