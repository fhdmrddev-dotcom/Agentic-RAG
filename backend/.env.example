# ============================================================
# Agentic RAG — Backend environment variables
# ============================================================
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env (it's gitignored).
#
# Local-vs-cloud switch: change SUPABASE_URL + REDIS_URL only.
# All other secrets are provider keys; they don't change between envs.
# ============================================================


# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
# Local (default — `supabase start` provides these):
#   SUPABASE_URL=http://127.0.0.1:54321
# Cloud:
#   SUPABASE_URL=https://<project-ref>.supabase.co

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_URL=http://127.0.0.1:54321

# Convenience aliases — most code uses SUPABASE_URL + a path suffix
SUPABASE_REST_URL=
SUPABASE_GRAPHQL_URL=
SUPABASE_FUNCTIONS_URL=

# Direct Postgres connection (used by migrations + admin scripts, not the runtime)
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Auth keys — local CLI defaults are fine for local; rotate for cloud
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Storage (S3-compatible)
SUPABASE_STORAGE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Local dev tools (Supabase CLI)
SUPABASE_STUDIO_URL=
SUPABASE_MAILPIT_URL=
SUPABASE_MCP_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Redis (v2.5+ — run-backed streaming buffer; see Phase 061 / D-v2.5-08)
# ─────────────────────────────────────────────────────────────────────────────
# Local (default — `docker compose -f docker-compose.dev.yml up -d`):
#   REDIS_URL=redis://localhost:6379
# Cloud (Upstash example — note rediss:// for TLS):
#   REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

REDIS_URL=redis://localhost:6379


# ─────────────────────────────────────────────────────────────────────────────
# asyncpg pool (v2.6+ — hot-path Postgres I/O; see Phase 073 / WORKER-LIFT-02)
# ─────────────────────────────────────────────────────────────────────────────
# Local (default — Supabase CLI exposes direct Postgres on :54322):
#   POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cloud (paste from Supabase dashboard — Connection Info → Direct connection
# string on :5432; NOT the pooler on :6543 per D-073-01).

POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10


# ─────────────────────────────────────────────────────────────────────────────
# LLM providers
# ─────────────────────────────────────────────────────────────────────────────
# Default provider for chat. One of: openai | anthropic | google | openrouter | ollama
LLM_PROVIDER=openai

# Provider API keys — set whichever providers you intend to use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Ollama runs locally — no key needed
OLLAMA_BASE_URL=http://localhost:11434

# Per-provider model lists (comma-separated). Drives the Settings UI dropdowns.
# Keep these in sync with MODEL_CAPABILITIES; pick current real model IDs.
OPENAI_MODELS=gpt-4o,gpt-4o-mini,gpt-4.1,gpt-4.1-mini
ANTHROPIC_MODELS=claude-opus-4-7,claude-sonnet-4-6,claude-haiku-4-5-20251001
GOOGLE_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite
OPENROUTER_MODELS=
OLLAMA_MODELS=llama3.2,mistral


# ─────────────────────────────────────────────────────────────────────────────
# Embeddings (used by ingestion + retrieval)
# ─────────────────────────────────────────────────────────────────────────────
# Falls back to LLM provider key if EMBEDDING_API_KEY is empty
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# Must match your embedding model output dimension.
# 1536 = OpenAI text-embedding-3-small | 768 = nomic-embed-text | 384 = MiniLM-L6
# Changing this requires resize_embedding_column + full re-ingestion
EMBEDDING_DIMENSIONS=1536


# ─────────────────────────────────────────────────────────────────────────────
# Retrieval & chunking
# ─────────────────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_MATCH_THRESHOLD=0.3
CHUNK_SIZE=1000
CHUNK_OVERLAP=200


# ─────────────────────────────────────────────────────────────────────────────
# Hybrid search & reranking
# ─────────────────────────────────────────────────────────────────────────────
HYBRID_SEARCH_ENABLED=true
HYBRID_CANDIDATE_COUNT=20
VECTOR_SEARCH_WEIGHT=1.0
KEYWORD_SEARCH_WEIGHT=1.0
RRF_K=60

RERANK_ENABLED=false
RERANK_PROVIDER=cohere
RERANK_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_TOP_N=5


# ─────────────────────────────────────────────────────────────────────────────
# Web search (Tavily)
# ─────────────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5


# ─────────────────────────────────────────────────────────────────────────────
# Observability (LangSmith)
# ─────────────────────────────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag
LANGSMITH_TRACING=true


# ─────────────────────────────────────────────────────────────────────────────
# Code execution sandbox
# ─────────────────────────────────────────────────────────────────────────────
# Requires Docker + the llm-sandbox image. Set false to disable code-execution tool.
SANDBOX_ENABLED=true

# SANDBOX_IMAGE (optional): pin sandbox containers to a custom Docker image with
# pre-installed packages instead of llm_sandbox's default bare-Python image.
# When unset, sandbox sessions start from a minimal Python image and the agent
# has to `pip install` matplotlib / pandas / etc. on every fresh thread (~10-15s
# warm-up per package).
#
# To activate (one-time per machine):
#   docker build -f backend/Dockerfile.sandbox -t agentic-rag-sandbox:075.1 backend/
# then set:
#   SANDBOX_IMAGE=agentic-rag-sandbox:075.1
# Pre-installed in this image: matplotlib, numpy, pandas, python-pptx,
# openpyxl, python-docx, pypdf, seaborn, scipy, scikit-learn, plotly.
# Brings the sandbox in line with Claude.ai analysis-tool capability set.
# (Shipped in Phase 075.1; expansion 2026-05-21.)
# SANDBOX_IMAGE=agentic-rag-sandbox:075.1


# ─────────────────────────────────────────────────────────────────────────────
# PDF/DOCX extraction
# ─────────────────────────────────────────────────────────────────────────────
# PYMUPDF_TIMEOUT_S: subprocess timeout for the AGPL-fenced PyMuPDF child (D-071-03).
# On timeout, child is SIGKILL'd and caller raises ExtractionError("pymupdf timed out after Ns").
PYMUPDF_TIMEOUT_S=60
