# Phase 075.1 Plan 04 (B-260519-08) — sandbox base image with common
# data-science + document-generation packages pre-installed.
#
# CANONICAL PACKAGE DOC: docs/SANDBOX-PACKAGES.md (what's installed, why, the
# add-a-package / size-perf rules). This pip line is the machine truth — keep the
# doc in sync in the SAME commit whenever the package set below changes.
#
# Why: pre-Plan-04, the agent loop crashed on first ModuleNotFoundError
# because the default llm_sandbox image had no python-pptx / matplotlib /
# numpy / pandas. OpenAI gpt-5.4 gave up after the failure (UAT
# B-260519-08); other providers retried with pip install but cost the user
# a 10-30s warm-up per cell. Pre-installing the four hot packages makes
# the dissertation-defense prompt succeed on first try and saves the
# warm-up cost on every other code-execution prompt that touches charts
# or documents.
#
# Image versions pinned for supply-chain stability (T-075.1-04-04).
# Pull from the default PyPI index — no arbitrary registries.
FROM python:3.11-slim

# Phase 075.1 Plan 04 — common pre-installs. Pin to specific versions to
# keep wheel cache deterministic across builds; bump versions deliberately
# in a follow-up phase if upstream releases bring a needed fix.
#
# 2026-05-21 expansion: added 7 next-tier packages to bring the sandbox
# in line with Claude.ai's analysis-tool default capability set — Office
# doc read/write (openpyxl, python-docx, pypdf), better charting (seaborn,
# plotly), and basic scientific computing + ML (scipy, scikit-learn).
# Image size ~558 MB → ~700 MB. Each addition is justified by the dissertation
# / data-analysis workflows the user actually runs through the agent.
# Deliberately omitted: requests/beautifulsoup4 (sandbox network is sealed),
# opencv-python (heavy, rare), transformers/torch/tensorflow (gigabytes,
# agent IS the LLM), nltk/spacy (need model downloads), pdfplumber (pypdf
# covers the 80%).
#
# 2026-05-31: added reportlab — pypdf only READS pdfs; there was NO PDF-WRITING
# library, so "generate a 1-page PDF report" prompts failed with no engine
# (operator-reported). reportlab is part of Claude.ai's analysis-tool set, which
# this comment cites as the bar. Rebuild + bump SANDBOX_IMAGE to pick it up
# (new chats only — sessions are cached per thread_id until idle eviction).
# 2026-06-10 (Phase 101 / TMPL-02): docxtpl — the trusted-path Jinja render engine
# (the LLM produces the cited field-map, docxtpl produces the OOXML bytes). The ONLY
# net-new sandbox dep; python-docx/pptx/openpyxl already present. Rebuild + bump
# SANDBOX_IMAGE to pick it up (new chats only — sessions are cached per thread_id
# until idle eviction). NOT added to backend/requirements.txt: production code never
# imports docxtpl (render runs in the sandbox; a backend import would be Pitfall 4).
RUN pip install --no-cache-dir \
    python-pptx==1.0.2 \
    matplotlib==3.9.2 \
    numpy==2.1.3 \
    pandas==2.2.3 \
    openpyxl==3.1.5 \
    python-docx==1.1.2 \
    pypdf==5.1.0 \
    reportlab==4.2.5 \
    docxtpl==0.20.2 \
    seaborn==0.13.2 \
    scipy==1.14.1 \
    scikit-learn==1.5.2 \
    plotly==5.24.1

# Mirror llm_sandbox default workdir + ensure the output directory exists
# so harvest_output_files's copy_from_runtime("/sandbox/output", tmpdir)
# never 404s on a clean cell.
WORKDIR /sandbox
RUN mkdir -p /sandbox/output
