# Keep the build context small and secret-free.
venv/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
logs/
*.log
uvicorn.*.log

# Secrets — env comes from Coolify at runtime, never from the image
.env
.env.*
settings_override.json*

# Not needed at runtime
tests/
supabase/
Dockerfile.sandbox
.dockerignore
RUN-BACKEND.md
